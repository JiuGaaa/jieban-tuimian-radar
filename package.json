{
  "name": "jieban-tuimian-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:public": "node scripts/build-public.mjs",
    "start": "node server/index.mjs",
    "sync:now": "node scripts/sync-once.mjs",
    "sync:export": "node scripts/export-feed.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:visual": "node scripts/visual-qa.mjs",
    "android:add": "cap add android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "node scripts/build-android-web.mjs && cap sync android",
    "android:apk": "node scripts/build-apk.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "@supabase/supabase-js": "^2.111.0",
    "cheerio": "^1.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "^10.0.4",
    "puppeteer-core": "25.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
